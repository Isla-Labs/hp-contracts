# Copy to .env and fill in. Loaded by Makefile via:
#   -include .env
#   export
#
# Rules for Make:
#   - KEY=value only (no [sections], no TOML/JSON)
#   - no spaces around =
#   - no wrapping quotes (Make keeps them as part of the value)
#   - # comments are fine
#   - empty values are fine (KEY=)
#
# Contract addresses (except AddressProvider) live onchain in AddressProvider.
# Sequential Sepolia order (each step registers its names on AP):
#   1) deploy-base-sepolia-oracle              (or after AP; auto-setName CVM_* if AP set)
#   2) deploy-base-sepolia-address-provider    → paste ADDRESS_PROVIDER
#   3) deploy-base-sepolia-orchestrator
#   4) deploy-base-sepolia-registries
#   5) deploy-base-sepolia-deploy-tournament
#   6) deploy-base-sepolia-data               (RoundManager)
#   7) deploy-base-sepolia-lockers
#   8) deploy-base-sepolia-factories
#   9) deploy-base-sepolia-handoff            (AP + ProxyAdmins → Orchestrator)
# Resolve names: AddressProvider.getAddress("ORCHESTRATOR") etc.

# ---------------------------------------------------------------------------
# Deployer (required for all make deploy-*)
# ---------------------------------------------------------------------------
# Hex private key — with or without 0x (forge accepts both for --private-key /
# vm.envUint depending on usage; prefer 0x-prefixed).
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Network / verify (required for deploy targets)
# ---------------------------------------------------------------------------
CHAIN_ID_BASE=8453
CHAIN_ID_BASE_SEPOLIA=84532
BASE_MAINNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Etherscan API v2 multichain prefix (chain id is appended by Makefile)
VERIFIER_URL=https://api.etherscan.io/v2/api?chainid=
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Access (optional on Sepolia — defaults to deployer if unset)
# ---------------------------------------------------------------------------
# EOA or Safe multisig that owns Orchestrator
OWNER_ADDRESS=
# Legacy alias accepted by scripts (fallback when OWNER_ADDRESS unset)
# DAO_ADDRESS=

# ---------------------------------------------------------------------------
# Address book (sole pointer — from `make deploy-*-address-provider`)
# ---------------------------------------------------------------------------
# Keep deployer as owner until deploy-*-handoff. Oracle / each step setName while owner.
# Fallback if oracle ran before AP: staging `npm run script:set-address -- CVM_ROUTER=0x…`
ADDRESS_PROVIDER=

# ---------------------------------------------------------------------------
# DeployData (per domestic league) — optional until data deploy
# ---------------------------------------------------------------------------
KEYSTONE_FORWARDER=
SQUAD_FILL_WORKFLOW_ID=
BASE_YEAR=2025
ELIGIBILITY_COOLDOWN=

# ---------------------------------------------------------------------------
# Oracle (Base Sepolia) — optional
# ---------------------------------------------------------------------------
# Pass at deploy: COMPOSE_HASH=0x… make deploy-base-sepolia-oracle
# Or later:      make oracle-sepolia-add-compose COMPOSE_HASH=0x…
# COMPOSE_HASH=
USE_MOCK_VERIFIER=false
# REGISTRATION_TTL=
# MAX_QUOTE_AGE=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
GITHUB_REPO=Isla-Labs/hp-v1-contracts
